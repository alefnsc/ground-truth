{
  "name": "@ground-truth/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs && node scripts/verify-model.mjs",
    "dev": "vite",
    "predev:https": "node scripts/copy-wasm.mjs && node scripts/verify-model.mjs",
    "dev:https": "vite --host --mode https",
    "prebuild": "node scripts/copy-wasm.mjs && node scripts/verify-model.mjs",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ground-truth/capture": "*",
    "@ground-truth/physics": "*",
    "@mediapipe/tasks-vision": "1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
